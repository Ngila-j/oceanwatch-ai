  create  table "oceanwatch_db"."public"."fact_ocean_conditions__dbt_tmp"
  
  
    as
  
  (
    

with sst as (
    select
        time::date                      as date_key,
        thetao_mean                     as sst_celsius,
        source_file                     as sst_source_file
    from "oceanwatch_db"."public"."raw_sst_daily"
),

chl as (
    select
        time::date                      as date_key,
        "CHL_mean"                      as chlorophyll_mg_m3,
        source_file                     as chl_source_file
    from "oceanwatch_db"."public"."raw_chl_daily"
)

select
    coalesce(s.date_key, c.date_key)    as date_key,
    1                                   as location_key,
    s.sst_celsius,
    c.chlorophyll_mg_m3,
    s.sst_source_file,
    c.chl_source_file,
    current_timestamp                   as loaded_at
from sst s
full outer join chl c
    on s.date_key = c.date_key
  );
  
