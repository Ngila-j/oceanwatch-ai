  create  table "oceanwatch_db"."public"."feat_daily_ocean__dbt_tmp"
  
  
    as
  
  (
    

select
    date_key,
    sst_celsius,
    chlorophyll_mg_m3,
    tide_mean_m,
    tide_min_m,
    tide_max_m,
    lag(sst_celsius, 1) over (order by date_key) as sst_lag_1,
