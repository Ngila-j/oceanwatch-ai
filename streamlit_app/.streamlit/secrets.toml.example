# Copy values into Streamlit Community Cloud → App settings → Secrets
# (do NOT commit a real secrets.toml — it is gitignored)

# Option A — single URI (recommended)
OCEANWATCH_DB_URI = "postgresql://USER:PASSWORD@HOST:5432/oceanwatch_db?sslmode=require"

# Option B — same key Cloud/Heroku often use
# DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/oceanwatch_db?sslmode=require"

# Option C — structured
# [db]
# uri = "postgresql://USER:PASSWORD@HOST:5432/oceanwatch_db?sslmode=require"
# # or:
# # host = "db.example.com"
# # port = 5432
# # user = "oceanwatch"
# # password = "…"
# # database = "oceanwatch_db"
