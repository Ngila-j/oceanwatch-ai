# Copy into:
#   - Streamlit Community Cloud → App settings → Secrets
#   - OR local: streamlit_app/.streamlit/secrets.toml  (gitignored)
#
# Do NOT commit real passwords.

# ── Supabase project: yigpktdypxstwnebvlpj ──────────────────────────
# Dashboard: https://supabase.com/dashboard/project/yigpktdypxstwnebvlpj
#
# Get the URI:
#   Project Settings → Database → Connection string → URI
#   Mode: "Transaction" pooler  (port 6543)  ← use this for Streamlit Cloud
#   Database password = the one you set at project creation
#   (Reset under Settings → Database if forgotten.)
#
# Replace YOUR_DB_PASSWORD below (URL-encode special chars: @ → %40  # → %23  etc.)

# Option A — single URI (recommended)
OCEANWATCH_DB_URI = "postgresql://postgres.yigpktdypxstwnebvlpj:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require"

# If your Supabase region host differs, copy the exact host from the dashboard
# (Settings → Database → Connection string). Common shapes:
#   aws-0-<region>.pooler.supabase.com:6543   ← transaction pooler (Cloud / serverless)
#   db.yigpktdypxstwnebvlpj.supabase.co:5432  ← direct (local scripts / migrations OK)

# Option B — parts (also supported by db_config.py)
# [db]
# host = "aws-0-eu-west-1.pooler.supabase.com"
# port = "6543"
# user = "postgres.yigpktdypxstwnebvlpj"
