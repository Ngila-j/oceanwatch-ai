# Copy to ingestion/.env and fill in — DO NOT COMMIT .env
#
# Free / no-key feeds (already wired — no signup):
#   python ingestion/fetch_free_live_feeds.py
#   → Open-Meteo weather + marine, USGS earthquakes
#
# Free tier keys YOU create (we cannot register accounts for you):
#   AISStream  https://aisstream.io/
#   GFW API    https://globalfishingwatch.org/our-apis/
#   Copernicus https://data.marine.copernicus.eu/
#
# KPA 14-day list has no public API — upload DOCX in Streamlit
#   Live Feeds & KPA List page, or:
#   python ingestion/ingest_kpa_shipping_movement.py path/to/list.docx

COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
AISSTREAM_API_KEY=
GFW_API_TOKEN=

# Database (host Streamlit / local scripts)
OCEANWATCH_DB_URI=

# API
OCEANWATCH_API_BASE=http://localhost:8000
